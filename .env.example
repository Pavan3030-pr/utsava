# Required — free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional — model used when the primary is overloaded or returns malformed output (default: gemini-2.5-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional — global rate limiting across all serverless instances (free tier at https://upstash.com).
# Without these, the app falls back to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — canonical site URL used for sitemap, Open Graph and RSVP links (e.g. https://utsava-weld.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Optional — only used as a fallback when no Google key is present
OPENAI_API_KEY=

# Supabase (optional but recommended): real database, RSVPs, sync across devices
# Without these the app runs local-only (plans saved in the browser, no guest RSVPs).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used by the public RSVP endpoint. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
